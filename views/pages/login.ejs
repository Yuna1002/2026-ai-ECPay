<div id="app" class="max-w-[1440px] mx-auto flex flex-col lg:flex-row lg:min-h-[820px]">
  <div class="relative h-[260px] lg:h-auto lg:w-1/2 shrink-0 bg-mist">
    <img
      src="https://images.unsplash.com/photo-1563241527-3004b7be0ffd?w=1200"
      alt="粉色玫瑰與白色洋桔梗組成的花束"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/0 from-35% to-ink/80"></div>
    <p class="absolute left-4 right-4 bottom-5 lg:left-12 lg:bottom-12 font-serif-tc font-black text-white text-[28px] lg:text-5xl leading-[1.3]">
      訂閱這一季，<br>花會自己找上門。
    </p>
  </div>

  <div class="flex-1 flex flex-col justify-center px-4 md:px-8 lg:px-[120px] pt-7 pb-12 lg:py-16">
    <div class="w-full max-w-[480px]">
      <div class="flex gap-7 lg:gap-10 border-b border-mist" role="tablist" aria-label="登入或註冊">
        <button
          v-for="tab in [{ key: 'login', label: '登入' }, { key: 'register', label: '註冊' }]"
          :key="tab.key"
          type="button"
          role="tab"
          :aria-selected="activeTab === tab.key"
          @click="activeTab = tab.key; errors = {}"
          class="pb-2.5 lg:pb-3.5 -mb-px border-b-[3px] font-serif-tc text-2xl lg:text-[32px] transition-colors"
          :class="activeTab === tab.key ? 'border-ink text-ink font-black' : 'border-transparent text-muted hover:text-ink'"
        >
          {{ tab.label }}
        </button>
      </div>

      <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="flex flex-col gap-7 lg:gap-8 pt-7 lg:pt-10" novalidate>
        <div>
          <label for="login-email" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">Email</label>
          <input id="login-email" v-model="loginForm.email" type="email" autocomplete="email" placeholder="you@example.com" class="field-input" :class="{ 'is-invalid': errors.email }" />
          <p v-if="errors.email" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.email }}</p>
        </div>
        <div>
          <label for="login-password" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">密碼</label>
          <input id="login-password" v-model="loginForm.password" type="password" autocomplete="current-password" class="field-input" :class="{ 'is-invalid': errors.password }" />
          <p v-if="errors.password" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.password }}</p>
        </div>
        <button type="submit" :disabled="submitting" class="w-full bg-peony text-white rounded-full py-3.5 lg:py-[18px] text-[15px] lg:text-base font-medium hover:bg-peony-dark transition-colors disabled:opacity-60 mt-2">
          {{ submitting ? '登入中…' : '登入' }}
        </button>
        <p class="text-[13px] text-muted">還沒有帳號？切換到「註冊」，三個欄位就能完成。</p>
      </form>

      <form v-else @submit.prevent="handleRegister" class="flex flex-col gap-7 lg:gap-8 pt-7 lg:pt-10" novalidate>
        <div>
          <label for="register-name" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">姓名</label>
          <input id="register-name" v-model="registerForm.name" type="text" autocomplete="name" class="field-input" :class="{ 'is-invalid': errors.name }" />
          <p v-if="errors.name" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.name }}</p>
        </div>
        <div>
          <label for="register-email" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">Email</label>
          <input id="register-email" v-model="registerForm.email" type="email" autocomplete="email" placeholder="you@example.com" class="field-input" :class="{ 'is-invalid': errors.email }" />
          <p v-if="errors.email" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.email }}</p>
        </div>
        <div>
          <label for="register-password" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">密碼</label>
          <input id="register-password" v-model="registerForm.password" type="password" autocomplete="new-password" placeholder="至少 6 個字元" class="field-input" :class="{ 'is-invalid': errors.password }" />
          <p v-if="errors.password" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.password }}</p>
        </div>
        <button type="submit" :disabled="submitting" class="w-full bg-peony text-white rounded-full py-3.5 lg:py-[18px] text-[15px] lg:text-base font-medium hover:bg-peony-dark transition-colors disabled:opacity-60 mt-2">
          {{ submitting ? '註冊中…' : '註冊' }}
        </button>
      </form>
    </div>
  </div>
</div>
