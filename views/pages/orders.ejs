<div id="app" class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-16 pt-7 lg:pt-14 pb-12 lg:pb-28">
  <div class="flex items-end justify-between border-b-2 border-ink pb-3 lg:pb-5">
    <h1 class="font-serif-tc font-black text-[40px] lg:text-[72px] leading-none text-ink">我的訂單</h1>
    <p v-if="!loading && orders.length" class="text-xs lg:text-sm text-muted">共 {{ orders.length }} 筆</p>
  </div>

  <div v-if="loading" class="flex justify-center py-24" aria-label="載入中">
    <div class="w-8 h-8 border-2 border-ink border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="orders.length === 0" class="py-16 lg:py-24 max-w-xl">
    <p class="font-serif-tc font-black text-3xl lg:text-5xl text-ink mb-4">還沒有訂單</p>
    <p class="font-serif-tc text-stem leading-[1.9] mb-8">第一束花送出後，訂單會記在這裡。</p>
    <a href="/#products" class="inline-block bg-peony text-white rounded-full px-8 py-3.5 text-[15px] font-medium hover:bg-peony-dark transition-colors">看本期花束</a>
  </div>

  <div v-else class="pt-2 lg:pt-6">
    <div class="hidden lg:flex gap-6 py-3 text-[13px] text-muted">
      <span class="flex-1">訂單編號</span>
      <span class="w-[200px]">下單日期</span>
      <span class="w-[180px]">金額</span>
      <span class="w-[140px]">狀態</span>
    </div>
    <ul>
      <li v-for="order in orders" :key="order.id" class="border-b lg:border-b-0 lg:border-t border-mist">
        <a :href="'/orders/' + order.id" class="flex flex-col lg:flex-row lg:items-center gap-2.5 lg:gap-6 py-5 lg:py-7 group">
          <span class="num text-xl lg:text-[26px] text-ink lg:flex-1 group-hover:text-peony transition-colors break-all">{{ order.order_no }}</span>
          <span class="flex items-center justify-between lg:contents">
            <span class="flex gap-4 lg:contents">
              <span class="num text-sm lg:text-base text-muted lg:w-[200px]">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</span>
              <span class="num text-sm lg:text-xl text-muted lg:text-ink lg:w-[180px]">NT$ {{ order.total_amount.toLocaleString() }}</span>
            </span>
            <span class="flex items-center justify-between lg:w-[140px]">
              <span class="flex items-center gap-2 text-[13px] lg:text-sm font-medium" :class="statusMap[order.status]?.cls || 'text-muted'">
                <span class="w-2 h-2 rounded-full bg-current" aria-hidden="true"></span>
                {{ statusMap[order.status]?.label || order.status }}
              </span>
              <svg class="hidden lg:block text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</div>
