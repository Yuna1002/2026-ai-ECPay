<div id="app" class="max-w-[1440px] mx-auto">
  <!-- 封面：直書主標 + 滿版主圖 + 本期目錄 -->
  <section class="px-4 md:px-8 lg:px-16 pt-6 lg:pt-12 pb-10 lg:pb-16 flex flex-col lg:flex-row gap-5 lg:gap-10 lg:h-[760px]">
    <div class="lg:w-[200px] flex flex-col justify-between gap-5 shrink-0">
      <p class="lg:hidden font-latin italic text-[13px] text-muted">Flower Life — 2026 秋季號</p>
      <h1 class="vertical-title font-serif-tc font-black text-ink text-[56px] lg:text-[84px] leading-[1.1] lg:leading-[1.02] lg:tracking-[0.04em]" aria-label="花是季節寄來的信">
        <span aria-hidden="true">
          <% '花是季節'.split('').forEach(function (ch, i) { %><span class="cover-char" style="--i: <%= i %>"><%= ch %></span><% }) %><br>
          <span class="lg:inline-block lg:pt-[120px]"><% '寄來的信'.split('').forEach(function (ch, i) { %><span class="cover-char" style="--i: <%= i + 4 %>"><%= ch %></span><% }) %></span>
        </span>
      </h1>
      <p class="hidden lg:block font-serif-tc text-[15px] leading-[1.9] text-stem">
        這一季，花藝師從產地挑回十二種花材，綁成你在家也照顧得來的花束。
      </p>
    </div>

    <figure class="relative flex-1 min-h-[440px] lg:min-h-0 bg-mist">
      <img
        src="https://images.unsplash.com/photo-1487530811176-3780de880c2d?w=1400"
        alt="以粉色玫瑰、白色牡丹與尤加利葉綁成的大型花束"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <figcaption v-if="products.length" class="absolute left-4 bottom-4 lg:left-7 lg:bottom-7 bg-paper px-4 py-2.5 text-[13px] text-ink">
        本期主打：{{ products[0].name }}，<span class="num">NT$ {{ products[0].price.toLocaleString() }}</span>
      </figcaption>
    </figure>

    <p class="lg:hidden font-serif-tc text-[15px] leading-[1.9] text-stem">
      這一季，花藝師從產地挑回十二種花材，綁成你在家也照顧得來的花束。
    </p>

    <aside class="lg:w-[300px] shrink-0 flex flex-col">
      <div class="hidden lg:block">
        <h2 class="font-serif-tc font-bold text-[22px] text-ink pb-2 border-b-2 border-ink">本期目錄</h2>
        <ol>
          <li v-for="(product, idx) in products.slice(0, 4)" :key="product.id" class="border-b border-mist">
            <a :href="'/products/' + product.id" class="flex gap-4 py-[18px] group">
              <span class="num text-[28px] font-light leading-none text-peony w-9">{{ String(idx + 1).padStart(2, '0') }}</span>
              <span class="flex flex-col gap-1 min-w-0">
                <span class="font-serif-tc font-bold text-[17px] text-ink truncate group-hover:text-peony transition-colors">{{ product.name }}</span>
                <span class="num text-sm text-muted">NT$ {{ product.price.toLocaleString() }}</span>
              </span>
            </a>
          </li>
        </ol>
      </div>
      <a href="#products" class="mt-auto block text-center bg-peony text-white rounded-full py-3.5 lg:py-4 font-medium text-[15px] hover:bg-peony-dark transition-colors">
        翻到所有花束
      </a>
    </aside>
  </section>

  <!-- 所有花束：錯落網格 -->
  <section id="products" class="px-4 md:px-8 lg:px-16 py-10 lg:py-24 scroll-mt-20">
    <div class="flex items-end justify-between border-b-2 border-ink pb-3 lg:pb-5 mb-8 lg:mb-12">
      <h2 class="font-serif-tc font-black text-[36px] lg:text-[64px] leading-none text-ink">所有花束</h2>
      <p v-if="!loading" class="text-[13px] lg:text-sm text-muted">
        共 {{ pagination.total }} 束<span v-if="pagination.totalPages > 1">，第 {{ pagination.page }} 頁</span>
      </p>
    </div>

    <div v-if="loading" class="flex justify-center py-16" aria-label="載入中">
      <div class="w-8 h-8 border-2 border-ink border-t-transparent rounded-full animate-spin"></div>
    </div>

    <template v-else>
      <div v-if="products.length === 0" class="py-16 max-w-md">
        <p class="font-serif-tc font-bold text-2xl text-ink mb-2">這一季的花還在路上</p>
        <p class="text-muted">新花束上架後會出現在這裡，晚點再回來看看。</p>
      </div>

      <div v-else class="grid grid-cols-2 max-lg:grid-flow-row-dense lg:grid-cols-12 gap-x-3.5 gap-y-8 lg:gap-x-12 lg:gap-y-16">
        <article
          v-for="(product, idx) in products"
          :key="product.id"
          :class="cardClass(idx)"
          class="flex flex-col gap-3 lg:gap-4"
        >
          <a :href="'/products/' + product.id" class="relative block overflow-hidden bg-mist" :class="isBig(idx) ? 'h-[420px] lg:h-[560px]' : 'h-[220px] lg:h-[440px]'">
            <img
              :src="product.image_url || fallbackImages[idx % fallbackImages.length]"
              :alt="product.name"
              loading="lazy"
              class="w-full h-full object-cover"
            />
            <span v-if="product.stock <= 0" class="absolute top-4 left-4 bg-ink text-paper text-xs px-3 py-1.5">已售完</span>
          </a>
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-2 lg:gap-6" :class="{ 'max-lg:flex-row max-lg:items-center max-lg:justify-between': isBig(idx) }">
            <div class="min-w-0">
              <h3 class="font-serif-tc font-bold text-ink" :class="isBig(idx) ? 'text-[22px] lg:text-[30px]' : 'text-base lg:text-[22px]'">
                <a :href="'/products/' + product.id" class="hover:text-peony transition-colors">{{ product.name }}</a>
              </h3>
              <p v-if="isBig(idx) && product.description" class="hidden lg:block mt-2 text-[15px] leading-[1.8] text-muted max-w-[52ch] line-clamp-2">{{ product.description }}</p>
            </div>
            <div class="flex lg:flex-col items-center lg:items-end gap-2.5 shrink-0">
              <p class="num text-peony" :class="isBig(idx) ? 'text-xl lg:text-[28px]' : 'text-base lg:text-[22px]'">NT$ {{ product.price.toLocaleString() }}</p>
              <button
                type="button"
                @click="addToCart(product)"
                :disabled="product._adding || product.stock <= 0"
                class="hidden lg:inline-block border border-ink rounded-full px-[18px] py-2 text-[13px] text-ink hover:bg-ink hover:text-paper transition-colors disabled:border-mist disabled:text-muted disabled:hover:bg-transparent disabled:cursor-not-allowed"
              >
                {{ product.stock <= 0 ? '已售完' : (product._adding ? '加入中…' : '加入購物車') }}
              </button>
            </div>
          </div>
          <button
            v-if="isBig(idx)"
            type="button"
            @click="addToCart(product)"
            :disabled="product._adding || product.stock <= 0"
            class="lg:hidden w-full border border-ink rounded-full py-3 text-sm text-ink disabled:border-mist disabled:text-muted"
          >
            {{ product.stock <= 0 ? '已售完' : (product._adding ? '加入中…' : '加入購物車') }}
          </button>
        </article>
      </div>

      <nav v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-12 lg:mt-16" aria-label="分頁">
        <button
          v-for="p in pagination.totalPages"
          :key="p"
          type="button"
          @click="changePage(p)"
          :aria-current="p === pagination.page ? 'page' : null"
          class="num w-11 h-11 rounded-full border border-ink text-base transition-colors"
          :class="p === pagination.page ? 'bg-ink text-paper' : 'text-ink hover:bg-pollen'"
        >
          {{ p }}
        </button>
      </nav>
    </template>
  </section>

  <!-- 品牌故事：引言跨頁 -->
  <section class="bg-pollen px-4 md:px-8 lg:px-16 py-10 lg:py-24 flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-16">
    <div class="hidden lg:block w-[520px] h-[640px] shrink-0 bg-mist">
      <img
        src="https://images.unsplash.com/photo-1563241527-3004b7be0ffd?w=900"
        alt="花藝師在工作桌上整理花材"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="flex flex-col gap-5 lg:gap-8">
      <span class="font-serif-tc font-black text-[72px] lg:text-[120px] leading-[0.8] text-peony" aria-hidden="true">「</span>
      <blockquote class="font-serif-tc font-bold text-[30px] lg:text-[52px] leading-[1.4] lg:leading-[1.35] text-ink">
        一束花能撐多久，<br class="hidden lg:inline">要看它離開土地時<br class="hidden lg:inline">被怎麼對待。
      </blockquote>
      <div class="grid lg:grid-cols-2 gap-5 lg:gap-10 font-serif-tc text-[15px] lg:text-base leading-[2] text-stem max-w-[68ch] lg:max-w-none">
        <p>花漾生活成立於 2020 年。我們每週兩次到花市與產地挑選花材，只收當天剪下的花，回到工作室後立刻吸水、去刺、修葉。</p>
        <p>每一束花都由同一位花藝師從頭綁到尾，附上照顧小卡：多久換一次水、該剪掉哪一段莖，讓花在你家多留幾天。</p>
      </div>
      <p class="text-sm font-medium text-ink">主理花藝師　林予晴</p>
    </div>
  </section>

  <!-- 讀者來信 -->
  <section class="px-4 md:px-8 lg:px-16 py-10 lg:py-24">
    <h2 class="font-serif-tc font-black text-[28px] lg:text-[40px] text-ink mb-5 lg:mb-10">讀者來信</h2>
    <div class="grid lg:grid-cols-3">
      <figure
        v-for="(letter, i) in letters"
        :key="i"
        class="flex flex-col gap-2 lg:gap-5 py-5 lg:py-2 border-b border-mist lg:border-b-0"
        :class="{ 'lg:border-l lg:pl-10': i > 0, 'lg:pr-10': i < letters.length - 1 }"
      >
        <blockquote class="font-serif-tc text-[17px] lg:text-xl leading-[1.8] text-ink">{{ letter.body }}</blockquote>
        <figcaption class="text-xs lg:text-[13px] text-muted">{{ letter.from }}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 服務條 -->
  <section class="mx-4 md:mx-8 lg:mx-16 mb-16 lg:mb-24 border-y-2 border-ink py-6 lg:py-7 grid sm:grid-cols-3 gap-5 sm:gap-12">
    <div class="flex items-center gap-4">
      <svg class="shrink-0 text-peony" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62L18.3 9.38a1 1 0 0 0-.78-.38H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
      <div>
        <p class="font-serif-tc font-bold text-[17px] text-ink">台北市區當日配送</p>
        <p class="text-[13px] text-muted">中午 12 點前下單，當天傍晚送達</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <svg class="shrink-0 text-peony" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
      <div>
        <p class="font-serif-tc font-bold text-[17px] text-ink">每束附照顧小卡</p>
        <p class="text-[13px] text-muted">換水、修莖的時間都寫在上面</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <svg class="shrink-0 text-peony" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/></svg>
      <div>
        <p class="font-serif-tc font-bold text-[17px] text-ink">滿 NT$ 500 免運</p>
        <p class="text-[13px] text-muted">未滿酌收運費 NT$ 150</p>
      </div>
    </div>
  </section>
</div>
