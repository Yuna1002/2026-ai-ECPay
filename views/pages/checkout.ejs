<div id="app" class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-16 pt-7 lg:pt-14 pb-10 lg:pb-28">
  <div class="flex items-end justify-between border-b-2 border-ink pb-3 lg:pb-5">
    <h1 class="font-serif-tc font-black text-[40px] lg:text-[72px] leading-none text-ink">結帳</h1>
    <p v-if="userName" class="text-xs lg:text-sm text-muted">會員：{{ userName }}</p>
  </div>

  <div v-if="loading" class="flex justify-center py-24" aria-label="載入中">
    <div class="w-8 h-8 border-2 border-ink border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else class="flex flex-col lg:flex-row lg:items-start gap-8 lg:gap-24 pt-6 lg:pt-12">
    <form class="flex-1 flex flex-col gap-7 lg:gap-9 max-w-[640px]" @submit.prevent="submitOrder" novalidate>
      <h2 class="font-serif-tc font-bold text-2xl lg:text-[32px] text-ink">花要送到哪裡？</h2>

      <div>
        <label for="recipient-name" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">收件人姓名</label>
        <input id="recipient-name" v-model="form.recipientName" type="text" autocomplete="name" placeholder="收花的人叫什麼名字" class="field-input" :class="{ 'is-invalid': errors.recipientName }" />
        <p v-if="errors.recipientName" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.recipientName }}</p>
      </div>
      <div>
        <label for="recipient-email" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">Email</label>
        <input id="recipient-email" v-model="form.recipientEmail" type="email" autocomplete="email" placeholder="訂單通知會寄到這裡" class="field-input" :class="{ 'is-invalid': errors.recipientEmail }" />
        <p v-if="errors.recipientEmail" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.recipientEmail }}</p>
      </div>
      <div>
        <label for="recipient-address" class="block text-[13px] lg:text-sm font-medium text-ink mb-1">收件地址</label>
        <input id="recipient-address" v-model="form.recipientAddress" type="text" autocomplete="street-address" placeholder="例：台北市大安區復興南路一段 100 號" class="field-input" :class="{ 'is-invalid': errors.recipientAddress }" />
        <p v-if="errors.recipientAddress" class="text-peony text-xs lg:text-[13px] mt-2">{{ errors.recipientAddress }}</p>
      </div>
    </form>

    <aside class="lg:w-[400px] shrink-0 bg-white border-t-4 border-ink p-5 lg:p-8 lg:sticky lg:top-28">
      <h2 class="font-serif-tc font-bold text-xl lg:text-[22px] text-ink mb-4">訂單摘要</h2>
      <ul class="space-y-2.5 pb-4 border-b border-mist text-sm">
        <li v-for="item in cartItems" :key="item.id" class="flex justify-between gap-4">
          <span class="text-ink min-w-0 truncate">{{ item.product.name }} × <span class="num">{{ item.quantity }}</span></span>
          <span class="num text-ink shrink-0">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
        </li>
      </ul>
      <dl class="space-y-3 text-sm pt-4">
        <div class="flex justify-between">
          <dt class="text-muted">商品小計</dt>
          <dd class="num text-ink">NT$ {{ cartTotal.toLocaleString() }}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-muted">運費</dt>
          <dd class="num text-ink">{{ cartTotal >= 500 ? '免運' : 'NT$ 150' }}</dd>
        </div>
      </dl>
      <div class="flex justify-between items-end border-t border-mist mt-4 pt-4">
        <span class="font-serif-tc font-bold text-ink">總計</span>
        <span class="num text-peony text-[28px] lg:text-[34px] leading-none">NT$ {{ (cartTotal + (cartTotal >= 500 ? 0 : 150)).toLocaleString() }}</span>
      </div>
      <button
        type="button"
        @click="submitOrder"
        :disabled="submitting"
        class="w-full mt-5 bg-peony text-white rounded-full py-3.5 lg:py-4 text-[15px] font-medium hover:bg-peony-dark transition-colors disabled:opacity-60"
      >
        {{ submitting ? '送出中…' : '確認送出訂單' }}
      </button>
    </aside>
  </div>
</div>
