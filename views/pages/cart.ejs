<div id="app" class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-16 pt-7 lg:pt-14 pb-10 lg:pb-28">
  <div class="flex items-end justify-between border-b-2 border-ink pb-3 lg:pb-5">
    <h1 class="font-serif-tc font-black text-[40px] lg:text-[72px] leading-none text-ink">購物車</h1>
    <p v-if="!loading && items.length" class="text-xs lg:text-sm text-muted">{{ items.length }} 束花</p>
  </div>

  <div v-if="loading" class="flex justify-center py-24" aria-label="載入中">
    <div class="w-8 h-8 border-2 border-ink border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="py-16 lg:py-24 max-w-xl">
    <p class="font-serif-tc font-black text-3xl lg:text-5xl text-ink mb-4">購物車還是空的</p>
    <p class="font-serif-tc text-stem leading-[1.9] mb-8">從本期花束裡挑一束吧，加入後會出現在這裡。</p>
    <a href="/#products" class="inline-block bg-peony text-white rounded-full px-8 py-3.5 text-[15px] font-medium hover:bg-peony-dark transition-colors">看本期花束</a>
  </div>

  <div v-else class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-16 pt-5 lg:pt-10">
    <div class="flex-1 min-w-0">
      <p v-if="total < 500" class="bg-pollen px-3.5 lg:px-5 py-3 lg:py-3.5 text-[13px] lg:text-sm text-ink">
        再買 <span class="num">NT$ {{ (500 - total).toLocaleString() }}</span> 就免運
      </p>
      <p v-else class="bg-pollen px-3.5 lg:px-5 py-3 lg:py-3.5 text-[13px] lg:text-sm text-stem flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        已達 NT$ 500 免運門檻
      </p>

      <ul>
        <li v-for="item in items" :key="item.id" class="flex gap-3.5 lg:gap-7 lg:items-center py-4 lg:py-7 border-b border-mist">
          <a :href="'/products/' + item.product.id" class="w-[84px] h-[104px] lg:w-[120px] lg:h-[150px] shrink-0 bg-mist">
            <img
              :src="item.product.image_url || 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?w=300'"
              :alt="item.product.name"
              class="w-full h-full object-cover"
            />
          </a>

          <div class="flex-1 min-w-0 flex flex-col lg:flex-row lg:items-center gap-2.5 lg:gap-7">
            <div class="flex-1 min-w-0 flex lg:flex-col justify-between lg:justify-start items-start gap-2">
              <h2 class="font-serif-tc font-bold text-[17px] lg:text-2xl text-ink truncate">{{ item.product.name }}</h2>
              <p class="hidden lg:block text-[13px] text-muted">單價 <span class="num">NT$ {{ item.product.price.toLocaleString() }}</span></p>
              <button type="button" @click="confirmDelete(item.id)" class="text-xs lg:text-[13px] text-muted underline underline-offset-4 hover:text-peony shrink-0">移除</button>
            </div>

            <div class="flex items-center justify-between lg:gap-7">
              <div class="flex items-center border border-ink rounded-full px-0.5 lg:px-1" role="group" :aria-label="item.product.name + ' 數量'">
                <button type="button" @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" class="w-8 lg:w-9 h-8 lg:h-9 num text-ink disabled:text-mist" aria-label="減少數量">−</button>
                <span class="w-7 lg:w-9 text-center num text-sm lg:text-base">{{ item.quantity }}</span>
                <button type="button" @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" class="w-8 lg:w-9 h-8 lg:h-9 num text-ink disabled:text-mist disabled:cursor-not-allowed" aria-label="增加數量">+</button>
              </div>
              <p class="num text-[17px] lg:text-[22px] text-ink lg:w-[140px] text-right">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
            </div>
          </div>
        </li>
      </ul>
    </div>

    <aside class="lg:w-[400px] shrink-0 bg-white border-t-4 border-ink p-5 lg:p-8 lg:sticky lg:top-28">
      <h2 class="font-serif-tc font-bold text-xl lg:text-[22px] text-ink mb-4">訂單摘要</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between">
          <dt class="text-muted">商品小計</dt>
          <dd class="num text-ink">NT$ {{ total.toLocaleString() }}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-muted">運費</dt>
          <dd class="num text-ink">{{ total >= 500 ? '免運' : 'NT$ 150' }}</dd>
        </div>
      </dl>
      <div class="flex justify-between items-end border-t border-mist mt-4 pt-4">
        <span class="font-serif-tc font-bold text-ink">總計</span>
        <span class="num text-peony text-[28px] lg:text-[34px] leading-none">NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span>
      </div>
      <button
        type="button"
        @click="goCheckout"
        class="w-full mt-5 bg-peony text-white rounded-full py-3.5 lg:py-4 text-[15px] font-medium hover:bg-peony-dark transition-colors"
      >
        前往結帳
      </button>
    </aside>
  </div>

  <!-- 移除確認 -->
  <div v-if="confirmVisible" class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <div class="absolute inset-0 bg-ink/50" @click="confirmVisible = false"></div>
    <div class="relative bg-paper w-full sm:max-w-sm sm:mx-4 border-t-4 border-ink p-6">
      <h3 id="confirm-title" class="font-serif-tc font-bold text-xl text-ink mb-2">移除這束花？</h3>
      <p class="text-sm text-muted mb-6">移除後可以再從商品頁加回來。</p>
      <div class="flex gap-3 justify-end">
        <button type="button" @click="confirmVisible = false" class="px-5 py-2.5 text-sm rounded-full border border-ink text-ink hover:bg-mist">保留</button>
        <button type="button" @click="handleDelete" class="px-5 py-2.5 text-sm rounded-full bg-peony text-white hover:bg-peony-dark">移除</button>
      </div>
    </div>
  </div>
</div>
